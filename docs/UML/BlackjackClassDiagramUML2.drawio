        <mxCell id="class_game" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=8;fontSize=12;strokeColor=#1f1f1f;fillColor=#ffffff;" value="&lt;div&gt;&lt;b&gt;Game&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left&quot;&gt;- player_: Player&lt;br&gt;- dealer_: Dealer&lt;br&gt;- ui_: ConsoleUI&lt;br&gt;- deck_: Deck&lt;br&gt;- reshuffleWhenAtOrBelow_: std::size_t = 10 {static, readOnly}&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ Game()&lt;br&gt;+ run(): void&lt;br&gt;- ensureDeckReady(): void&lt;br&gt;- playRound(): void&lt;br&gt;- initialDeal(deck: Deck): void&lt;br&gt;- handleInitialBlackjack(betCents: long long): bool&lt;br&gt;- playerTurn(deck: Deck, betCents: long long): void&lt;br&gt;- dealerTurn(deck: Deck): void&lt;br&gt;- determineOutcome(): RoundOutcome&lt;br&gt;- applyPayout(betCents: long long, playerBlackjack: bool, outcome: RoundOutcome): void&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;&lt;div style=&quot;text-align:left&quot;&gt;&amp;laquo;enumeration&amp;raquo; RoundOutcome: PlayerWin, DealerWin, Push&lt;/div&gt;" vertex="1">
