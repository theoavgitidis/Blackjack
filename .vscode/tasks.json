{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: build blackjack",
      "type": "cmake",
      "command": "build",
      "targets": ["blackjack"],
      "group": "build",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "CMake: build blackjack_tests",
      "type": "cmake",
      "command": "build",
      "targets": ["blackjack_tests"],
      "group": "build",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Run blackjack (ohne Debugger, nach Build)",
      "type": "shell",
      "dependsOn": ["CMake: build blackjack"],
      "dependsOrder": "sequence",
      "command": ".\\build\\Debug\\blackjack.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Run blackjack_tests (ohne Debugger, nach Build)",
      "type": "shell",
      "dependsOn": ["CMake: build blackjack_tests"],
      "dependsOrder": "sequence",
      "command": ".\\build\\Debug\\blackjack_tests.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "cmake-configure (VS + Tests)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build",
        "-G",
        "Visual Studio 17 2022",
        "-DBUILD_TESTING=ON"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$msCompile"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "cmake-build-debug",
      "type": "shell",
      "dependsOn": ["cmake-configure (VS + Tests)"],
      "command": "cmake",
      "args": ["--build", "build", "--config", "Debug"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$msCompile"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": "build"
    },
    {
      "label": "cmake-build-release",
      "type": "shell",
      "dependsOn": ["cmake-configure (VS + Tests)"],
      "command": "cmake",
      "args": ["--build", "build", "--config", "Release"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$msCompile"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": "build"
    }
  ]
}
