{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake-configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build",
        "-G",
        "Visual Studio 17 2022"
      ],
      "problemMatcher": ["$msCompile"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "cmake-build-debug",
      "type": "shell",
      "dependsOn": ["cmake-configure"],
      "command": "cmake",
      "args": ["--build", "build", "--config", "Debug"],
      "problemMatcher": ["$msCompile"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": "build"
    },
    {
      "label": "cmake-build-release",
      "type": "shell",
      "dependsOn": ["cmake-configure"],
      "command": "cmake",
      "args": ["--build", "build", "--config", "Release"],
      "problemMatcher": ["$msCompile"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": "build"
    }
  ]
}

