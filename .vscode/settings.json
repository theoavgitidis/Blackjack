{
  // blackjack.miDebuggerPath: GDB falls nicht in PATH (z.B. MSYS2 ucrt64 bin gdb.exe)
  "cmake.configureSettings": {
    "BUILD_TESTING": true
  },
  "cmake.debugConfig": {
    "cwd": "${workspaceFolder}",
    "console": "integratedTerminal",
    "stopAtEntry": false
  },
  "blackjack.miDebuggerPath": "gdb"
}
